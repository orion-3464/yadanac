def main

    def partition is int: low high as int, arr as int []
        var pivot i temp j is int
        pivot := arr[high]
        i := low - 1
        j := low

        loop:
        
            if j <= high-1:  break 
            if arr[j] < pivot:
            
                i := i + 1
                temp := arr[i]
                arr[i] := arr[j]
                arr[j] := temp
            j := j + 1
        temp := arr[i+1]
        arr[i+1] := arr[high]
        arr[high] := temp
        return: i+1
 
	      #pivot bloop   

    def quicksort: low high as int, arr as int []
        #var pivot is int
        if low <= high:
            pivot := partition(low, high, arr)
            # recursion
            quicksort: low, pivot-1, arr
            quicksort: pivot+1, high, arr
   
