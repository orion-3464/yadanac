def main
    def partition is int: low high as int, arr as int []
        var pivot i temp j is int
        pivot := arr[high]
        i := low - 1
        j := low

        loop:
            if j <= high-1:  break 
            if arr[j] < pivot:
                i := i + 1
                temp := arr[i]
                arr[i] := arr[j]
                arr[j] := temp
            j := j + 1
        temp := arr[i+1]
        arr[i+1] := arr[high]
        arr[high] := temp
        return: i+1 
    

    def quicksort: low high as int, arr as int []
        if low <= high:
            var pivot is int
            pivot := partition(low, high, arr)

            # recursion
            quicksort: low, pivot-1, arr
            quicksort: pivot+1, high, arr
    

    # Read the length of array from input
    var N is int
    N := readInteger()
    # Define the array of given length
    var nums is int [N]
    var k is int
    k := 0

    loop:
        if k < N: break 
        nums[k] := readInteger()
        k := k + 1
    

    quicksort: 0, N, nums

    k := 0
    loop:
        if i < n:
            if k > 0:  writeString: ”, ” 
            writeInteger: x[k]
            k := k+1
        else: 
            break
       
    writeString: ”\n”
