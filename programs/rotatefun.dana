# LeetCode problem: 396. Rotate Function (https://leetcode.com/problems/rotate-function/description/)
def main
begin
    def maxRotateFunction is int: n as int, nums as int []
    begin
        var sum prevF maxF i is int
        sum := 0
        prevF := 0
        maxF := 0
        i := 0

        loop:
        begin
            if i < n:
            begin      
                sum := sum + nums[i]
                prevF := prevF + i * nums[i]
                i := i + 1
            end
            else:
            begin 
                break
            end
        end

        maxF := prevF
        i := 1

        loop:
        begin
            if i < n:
            begin
                var F is int
                F := prevF + sum - n * nums[n-i]
                if F > maxF: begin maxF := F end
                prevF := F
                i := i + 1
            end 
            else: 
            begin
                break
            end
        end 
        
        return: maxF
    end

    var n is int
    n := readInteger()

    var nums is int [n]

    var i is int
    i := 0
    loop:
    begin
        if i < n:
        begin
            nums[i] := readInteger()
            i := i + 1
        end
        else: 
        begin
            break
        end
    end

    var result is int
    result := maxRotateFunction(n, nums)

    writeInteger: result
    writeString: "\n"
end