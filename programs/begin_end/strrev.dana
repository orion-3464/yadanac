def main
begin
    var r is byte [32]

    def reverse: s as byte []
    begin
        var i l is int

        l := strlen(s)
        i := 0

        loop:
        begin
            if i < l:
            begin
                r[i] := s[l-i-1]
                i := i+1
            end
            else:
            begin 
                break
            end
        end

        r[i] := '\0'
    end
    
    reverse: "\n!dlrow olleH"
    writeString: r
end