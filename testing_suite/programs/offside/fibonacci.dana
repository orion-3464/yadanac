def main
  var n is int
  var res is int

  var a is int
  var b is int
  def fib: n as int, result as ref int
    if n <= 0:
      result := 0
    elif n = 1:
      result := 1
    else:
      fib: n-1, a
      fib: n-2, b
      result := a + b


  n := readInteger()

  fib: n, res

  writeString: "Fibonacci of "
  writeInteger: n
  writeString: " is "
  writeInteger: res
  writeString: "\n"
