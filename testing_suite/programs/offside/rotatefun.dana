def main
  
  def maxRotateFunction is int: n as int, nums as int []

    var sum prevF maxF i is int
	var F is int
    sum := 0
    prevF := 0
    maxF := 0
    i := 0

    loop:
      if i < n:      
        sum := sum + nums[i]
        prevF := prevF + i * nums[i]
        i := i + 1
      else: break 


    maxF := prevF
    i := 1

    loop:
      if i < n:
        F := prevF + sum - n * nums[n-i]
        if F > maxF: maxF := F
        prevF := F
        i := i + 1
      else: break

    return: maxF
  var n is int
  
  var nums is int [3]

  var i is int
  var result is int

  n := readInteger()
  i := 0
  loop:
    if i < n:
      nums[i] := readInteger()
      i := i + 1
    else: break

  result := maxRotateFunction(n, nums)

  writeInteger: result
  writeString: "\n"
