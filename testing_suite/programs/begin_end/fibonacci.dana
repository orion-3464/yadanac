def main
    def fib: n as int, result as ref int
var a is int var b is int
    begin
        if n <= 0:
        begin
            result := 0
        end
        elif  n = 1:
        begin
            result := 1
        end
        else:
            begin 
            ifib: n-1, a
            fib: n-2, b
            result := a + b
        end end
        
     var n is int
     var res is int
    begin
        n := readInteger()

        fib: n, res

        writeString: "Fibonacci of "
        writeInteger: n
        writeString: " is "
        writeInteger: res
        writeString: "\n"
    end

