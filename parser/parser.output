   22 local_def: func_def
   23          | func_decl
   24          | var_def

   25 type: data_type bracket_int_const_list

   26 func_decl: "decl" header

   27 var_def: "var" T_id id_list "is" type

   28 block: "begin" stmt stmt_list "end"

   29 stmt_list: ε
