   67     | expr '|' expr

   68 proc_call: T_id one_col_expr

   69 one_col_expr: ε
   70             | ":" expr expr_list

   71 expr_list: ε
   72          | expr_list ',' expr

   73 func_call: T_id '(' one_expr ')'

   74 one_expr: ε
