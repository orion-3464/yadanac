   44 one_id: ε
   45       | T_id

   46 col_id: ε
   47       | ":" T_id

   48 l_value: T_id
   49        | T_str
   50        | l_value '[' expr ']'

   51 expr: T_const
   52     | T_char
   53     | l_value
