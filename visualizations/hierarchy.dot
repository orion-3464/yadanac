digraph AST {
    ast [label = "AST", shape = box, weight = 8, style = filled, color = ".6 .3 1.0"];

    stmt [label = "Stmt", shape = box, weight = 8, style = filled, color = ".6 1.0 .8"];
    expr [label = "Expr", shape = box, weight = 8, style = filled, color = "1.0 .4 .4"];
    data_type [label = "DataType", shape = box, weight = 8, style = filled, color = ".2 .6 .5"]; 
    local_def [label = "LocalDef", shape = box, weight = 8, style = filled, color = ".8 .6 .4"];

    cond [label = cond, weight = 8, style = filled, color = ".6 1.0 .9"];

    func_def;
    
    header;
    local_def;
    block;

    id;
    fpar_def;

    fpar_type;

    type;
    int_const;

    func_decl;
    var_def;

    l_value;
    proc_call;
    
    string_literal;

    ast -> { stmt, expr, data_type, local_def };

    expr -> { cond };

    func_def -> { header, local_def, block };

    header -> { id, data_type, fpar_def };

    fpar_def -> { id, fpar_type };

    type -> { data_type, int_const };

    fpar_type -> { type, data_type, int_const };

    local_def -> { func_def, func_decl, var_def };

    func_decl -> header;

    var_def -> { id, type };

    stmt -> { l_value, proc_call, block, cond, id };

    proc_call -> { id };

    func_call -> { id };

    l_value -> { id, string_literal, l_value };
}
