digraph AST {
    ast [label = "AST", shape = box, weight = 8, style = filled, color = ".6 .3 1.0"];

    stmt [label = "Stmt", shape = box, weight = 8, style = filled, color = ".6 1.0 .8"];
    expr [label = "Expr", shape = box, weight = 8, style = filled, color = "1.0 .4 .4"];
    data_type [label = "DataType", shape = box, weight = 8, style = filled, color = ".2 .6 .5"]; 
    local_def [label = "LocalDef", shape = box, weight = 8, style = filled, color = ".8 .6 .4"];

    cond [label = Cond, weight = 8, style = filled, color = "1.0 .4 .6"];
    const [label = Const, weight = 8, style = filled, color = "1.0 .4 .6"];
    id [label = Id, weight = 8, style = filled, color = "1.0 .4 .6"];
    char [label = Char, weight = 8, style = filled, color = "1.0 .4 .6"];
    str [label = Str, weight = 8, style = filled, color = "1.0 .4 .6"];
    expr_list [label = ExprList, weight = 8, style = filled, color = "1.0 .4 .6"];
    lvalue [label = Lvalue, weight = 8, style = filled, color = "1.0 .4 .6"];
    func_call [label = FuncCall, weight = 8, style = filled, color = "1.0 .4 .6"];
    un_expr [label = UnaryOpExpr, weight = 8, style = filled, color = "1.0 .4 .6"];
    bin_expr [label = BinaryOpExpr, weight = 8, style = filled, color = "1.0 .4 .6"];
    bool [label = BoolVal, weight = 8, style = filled, color = "1.0 .4 .6"];

    ast -> { stmt, expr, data_type, local_def };

    expr -> { cond, const, id, char, str, expr_list, lvalue, func_call, un_expr, bin_expr, bool };

}
